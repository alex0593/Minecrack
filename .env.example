# ============================================================
#  MINECRACK — Variables de Entorno
#  Copia este archivo como .env y rellena los valores vacíos.
#  NUNCA subas .env a git (ya está en .gitignore).
# ============================================================

# -----------------------------------------------------------
# CURSEFORGE API  (gratis en https://console.curseforge.com)
# -----------------------------------------------------------
VITE_CURSEFORGE_API_KEY=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------
# MODRINTH API  (sin key necesaria, pero puedes poner una
# para mayor rate limit — https://modrinth.com/settings/pats)
# -----------------------------------------------------------
VITE_MODRINTH_API_KEY=

# -----------------------------------------------------------
# URLs BASE DE APIS (no modificar salvo que cambien)
# -----------------------------------------------------------

# Mojang — versiones de Minecraft
VITE_MOJANG_VERSION_MANIFEST=https://launchermeta.mojang.com/mc/game/version_manifest_v2.json
VITE_MOJANG_ASSETS_BASE=https://resources.download.minecraft.net
VITE_MOJANG_LIBRARIES_BASE=https://libraries.minecraft.net

# Fabric loader
VITE_FABRIC_META_BASE=https://meta.fabricmc.net/v2
VITE_FABRIC_MAVEN_BASE=https://maven.fabricmc.net

# Quilt loader
VITE_QUILT_META_BASE=https://meta.quiltmc.org/v3
VITE_QUILT_MAVEN_BASE=https://maven.quiltmc.org

# Forge (Maven)
VITE_FORGE_MAVEN_BASE=https://maven.minecraftforge.net
VITE_FORGE_FILES_BASE=https://files.minecraftforge.net/net/minecraftforge/forge

# Modrinth
VITE_MODRINTH_API_BASE=https://api.modrinth.com/v2

# CurseForge
VITE_CURSEFORGE_API_BASE=https://api.curseforge.com/v1

# Prism Launcher Meta (fuente consolidada: loaders + requisitos Java por MC version)
VITE_PRISM_META_BASE=https://meta.prismlauncher.org/v1

# Adoptium (Java auto-download)
VITE_ADOPTIUM_API_BASE=https://api.adoptium.net/v3

# -----------------------------------------------------------
# CONFIG DEL LAUNCHER
# -----------------------------------------------------------

# RAM por defecto para nuevas instancias (MB)
VITE_DEFAULT_RAM=2048

# Máx descargas paralelas
VITE_MAX_CONCURRENT_DOWNLOADS=4

# Nombre interno del directorio base de instancias
VITE_INSTANCES_DIR_NAME=instances

# Versión mínima de Java requerida
VITE_MIN_JAVA_VERSION=17
